---
import type { CollectionEntry } from 'astro:content';
import { formatRange, isoMonth } from '../lib/dates';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { company, location, start, end, note, roles } = entry.data;
---

<article class="relative border-l border-border pl-6">
  <span
    class="absolute -left-[4.5px] top-2 size-2 rounded-full bg-accent"
    aria-hidden="true"
  ></span>

  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-lg font-medium tracking-tight text-fg">{company}</h3>
    <time class="text-xs text-subtle" datetime={isoMonth(start)}>
      {formatRange(start, end)}
    </time>
  </header>

  <p class="mt-0.5 text-sm text-subtle">{location}</p>
  {note && <p class="mt-2 text-sm italic text-muted">{note}</p>}

  <ol class="mt-5 space-y-6">
    {
      roles.map((role) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
            <h4 class="text-sm font-medium text-fg">
              {role.title}
              {role.end === null && (
                <span class="ml-2 rounded border border-accent/40 px-1.5 py-0.5 align-middle text-[0.65rem] uppercase tracking-wider text-accent">
                  Current
                </span>
              )}
            </h4>
            {/* Only show per-role dates when a company has more than one role —
                otherwise it just repeats the company range directly above. */}
            {roles.length > 1 && (
              <time class="text-xs text-subtle" datetime={isoMonth(role.start)}>
                {formatRange(role.start, role.end)}
              </time>
            )}
          </div>

          {role.highlights.length > 0 && (
            <ul class="mt-2.5 space-y-2">
              {role.highlights.map((h) => (
                <li class="flex gap-3 text-sm leading-relaxed text-muted">
                  <span
                    class="mt-2 size-1 shrink-0 rounded-full bg-border"
                    aria-hidden="true"
                  />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ol>
</article>
