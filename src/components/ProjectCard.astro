---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  name,
  tagline,
  summary,
  repo,
  demo,
  repoStatus,
  tech,
  highlights,
  icon,
  iconHover,
  iconInvertOnDark,
  iconSpinOnHover,
  screenshot,
  screenshotAlt,
} = project.data;

/* `<Image />` needs a real module, not a path string, so the frontmatter filename
   is resolved against a glob of the assets directory at build time. Eager so the
   metadata (width/height) is available during render. */
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);

/* Schema guarantees screenshotAlt matches screenshot in length, so the index
   lookup is safe. */
const gallery = (screenshot ?? []).map((file, i) => {
  const image = modules[`../assets/projects/${file}`]?.default;
  if (!image) {
    throw new Error(`${project.id}: screenshot "${file}" not found in src/assets/projects/`);
  }
  return { image, alt: screenshotAlt![i] };
});

const [lead, ...rest] = gallery;

/* A portrait shot would lose its content to a 16:9 crop, so the frame follows the
   image instead of the reverse. Phone captures are far taller again (~1:2.2) and
   would sit as a sliver in a 4:5 box, so they get a frame of their own. */
const frameFor = (image: ImageMetadata) => {
  const ratio = image.height / image.width;
  if (ratio > 1.5) return 'aspect-[9/16] object-contain';
  if (ratio > 1) return 'aspect-[4/5] object-contain';
  return 'aspect-[16/9] object-cover object-top';
};
---

<article
  class="group rounded-(--radius-card) border border-border bg-surface p-6 transition-colors hover:border-accent/40 sm:p-8"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    {
      icon && (
        /* With a hover mark, both icons occupy the same grid cell and cross-fade;
           stacking avoids the layout shift a src swap would cause. On its own, the
           single icon just sits in that cell. */
        <span class="grid size-8 shrink-0 place-items-center" aria-hidden="true">
          <img
            src={icon}
            alt=""
            class:list={[
              'col-start-1 row-start-1 size-8 transition-opacity duration-200',
              iconHover && 'group-hover:opacity-0',
              iconInvertOnDark && 'dark:invert',
              /* 1.8s matches the blade rotation in spinbook itself; the Tailwind
                 default of 1s reads as a loading spinner. motion-safe so it stays
                 still for reduced-motion visitors. */
              iconSpinOnHover &&
                'motion-safe:group-hover:animate-[spin_1.8s_linear_infinite]',
            ]}
          />
          {iconHover && (
            <img
              src={iconHover}
              alt=""
              class:list={[
                'col-start-1 row-start-1 size-8 opacity-0 transition-opacity duration-200 group-hover:opacity-100',
                iconInvertOnDark && 'dark:invert',
              ]}
            />
          )}
        </span>
      )
    }
    <h3 class="text-2xl font-bold tracking-tight text-fg">{name}</h3>
    {
      demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-auto text-sm font-medium text-accent hover:underline"
        >
          {new URL(demo).hostname}
        </a>
      )
    }
  </div>

  {/* whitespace-pre-line so a multi-line tagline keeps its break; single-line
      taglines are unaffected, and wrapping still works normally. */}
  <p class="mt-1 text-lg whitespace-pre-line text-muted">{tagline}</p>

  {
    lead && (
      <div class="mt-5 space-y-3">
        {/* Links straight to the optimized asset — a full-size view with no
            lightbox library, keeping the page free of client JS. */}
        <a
          href={lead.image.src}
          target="_blank"
          rel="noopener noreferrer"
          class="block overflow-hidden rounded-(--radius-card) border border-border"
        >
          <Image
            src={lead.image}
            alt={lead.alt}
            width={1200}
            loading="lazy"
            decoding="async"
            class={`w-full bg-bg transition-transform duration-300 group-hover:scale-[1.02] ${frameFor(lead.image)}`}
          />
        </a>

        {/* Secondary shots sit side by side on wider screens and stack on phones,
            where half a card width would render the UI detail unreadable. */}
        {rest.length > 0 && (
          <ul class="grid gap-3 sm:grid-cols-2">
            {rest.map((s) => (
              <li>
                <a
                  href={s.image.src}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block overflow-hidden rounded-(--radius-card) border border-border"
                >
                  <Image
                    src={s.image}
                    alt={s.alt}
                    width={600}
                    loading="lazy"
                    decoding="async"
                    class={`w-full bg-bg transition-transform duration-300 hover:scale-[1.02] ${frameFor(s.image)}`}
                  />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }

  <p class="mt-4 text-sm leading-relaxed text-muted">{summary}</p>

  {
    highlights.length > 0 && (
      <ul class="mt-5 space-y-2">
        {highlights.map((h) => (
          <li class="flex gap-3 text-sm text-muted">
            <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{h}</span>
          </li>
        ))}
      </ul>
    )
  }

  <ul class="mt-5 flex flex-wrap gap-1.5">
    {
      tech.map((t) => (
        <li class="rounded border border-border px-2 py-0.5 text-[0.7rem] text-subtle">
          {t}
        </li>
      ))
    }
  </ul>

  {/* The live-site link lives in the title row, so it is not repeated here. */}
  <div class="mt-5 flex flex-wrap items-center gap-4 text-sm">
    {
      repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-accent hover:underline"
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          Source
        </a>
      )
    }
    {
      !repo && repoStatus === 'private' && (
        <span class="text-subtle" title="Source is not publicly available">
          Private source
        </span>
      )
    }
  </div>
</article>
