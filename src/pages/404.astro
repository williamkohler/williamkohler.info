---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Bill Kohler">
  <section class="mx-auto max-w-(--container-site) px-6 py-28">
    <p class="text-xs uppercase tracking-[0.18em] text-accent">404</p>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight text-fg">Page not found</h1>
    <p class="mt-3 text-muted">That page doesn't exist.</p>
    <a href="/" class="mt-6 inline-block font-medium text-accent hover:underline">
      Back home
    </a>
  </section>
</BaseLayout>
