---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WorkEntry from '../components/WorkEntry.astro';
import { SITE, education } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <div id="top"></div>

  {/* ---- Hero ---- */}
  <section class="mx-auto max-w-(--container-site) px-6 py-20 sm:py-28">
    <p class="text-xs uppercase tracking-[0.18em] text-accent">
      {SITE.location}
    </p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tighter text-fg sm:text-5xl">
      {SITE.name}
    </h1>
    <p class="mt-3 text-xl text-muted sm:text-2xl">{SITE.role}</p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={`mailto:${SITE.email}`}
        class="rounded-md bg-fg px-4 py-2 text-sm font-medium text-bg transition-opacity hover:opacity-90"
      >
        Get in touch
      </a>
      <a
        href={SITE.resume}
        download="Bill-Kohler-Resume.pdf"
        class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-accent/50 hover:text-accent"
      >
        Resume (PDF)
      </a>
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-border px-4 py-2 text-sm font-medium text-fg transition-colors hover:border-accent/50 hover:text-accent"
      >
        GitHub
      </a>
    </div>
  </section>

  {/* ---- Projects ---- */}
  <Section id="projects" title="Projects">
    <div class="space-y-5">
      {featured.map((project) => <ProjectCard project={project} />)}

      <div class="grid gap-5 sm:grid-cols-2">
        {rest.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </Section>

  {/* ---- Work ---- */}
  <Section id="work" title="Experience">
    <div class="space-y-12">
      {work.map((entry) => <WorkEntry entry={entry} />)}
    </div>

    <div class="mt-12 border-t border-border/60 pt-8">
      <h3 class="text-xs uppercase tracking-[0.15em] text-subtle">Education</h3>
      {/* Same 72x56 logo box as WorkEntry so both lists align on the left. */}
      <ul class="mt-5 space-y-5">
        {
          education.map((e) => (
            <li class="flex gap-5 sm:gap-6">
              <img
                src={e.logo}
                alt={`${e.school} logo`}
                width="72"
                height="56"
                loading="lazy"
                decoding="async"
                class:list={[
                  'h-14 w-18 shrink-0 object-contain',
                  'brightenOnDark' in e && e.brightenOnDark && 'dark:brightness-150',
                ]}
              />
              <div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                <span class="text-sm text-fg">
                  {e.school}
                  <span class="text-muted"> — {e.credential}</span>
                </span>
                <span class="text-xs text-subtle">{e.year}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  {/* ---- Contact ---- */}
  <Section id="contact" title="Contact">
    <div class="max-w-2xl">
      <ul class="space-y-3 text-sm">
        <li>
          <a href={`mailto:${SITE.email}`} class="font-medium text-accent hover:underline">
            {SITE.email}
          </a>
        </li>
        <li>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-accent hover:underline"
          >
            github.com/williamkohler
          </a>
        </li>
        <li>
          <a
            href={SITE.resume}
            download="Bill-Kohler-Resume.pdf"
            class="font-medium text-accent hover:underline"
          >
            Download resume (PDF)
          </a>
        </li>
      </ul>
    </div>
  </Section>
</BaseLayout>
