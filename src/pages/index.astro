---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WorkEntry from '../components/WorkEntry.astro';
import { SITE, education } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <div id="top"></div>

  {/* ---- Hero ---- */}
  {/* Shorter than it was — the action buttons now live in the header. */}
  <section class="mx-auto max-w-(--container-site) px-6 py-14 sm:py-20">
    <h1 class="text-4xl font-semibold tracking-tighter text-fg sm:text-5xl">
      {SITE.name}
    </h1>
    <p class="mt-3 text-xl text-muted sm:text-2xl">{SITE.role} in {SITE.location}</p>

    {/* Contact details sit with the name rather than in their own section, so the
        page opens with everything needed to get in touch. */}
    <ul class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <li>
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-accent hover:underline"
        >
          github.com/williamkohler
        </a>
      </li>
      <li>
        <a
          href="https://hihat.online"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-accent hover:underline"
        >
          hihat.online
        </a>
      </li>
    </ul>
  </section>

  {/* ---- Projects ---- */}
  <Section id="projects" title="Projects">
    {/* One full-width stack — every card gets the same width and treatment. */}
    <div class="space-y-5">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Section>

  {/* ---- Work ---- */}
  <Section id="work" title="Experience">
    <div class="space-y-12">
      {work.map((entry) => <WorkEntry entry={entry} />)}
    </div>

    <div class="mt-12 border-t border-border/60 pt-8">
      <h3 class="text-xs uppercase tracking-[0.15em] text-subtle">Education</h3>
      {/* Same 72x56 logo box as WorkEntry so both lists align on the left. */}
      <ul class="mt-5 space-y-5">
        {
          education.map((e) => (
            <li class="flex items-center gap-5 sm:gap-6">
              {/* The grid centers the mark on both axes, so a wide wordmark like
                  Northeastern's 7:1 strip sits in the middle of the box instead of
                  floating in it. Padding keeps it off the border. */}
              <span class="grid h-14 w-18 shrink-0 place-items-center rounded-md border border-border bg-surface p-1.5">
                <img
                  src={e.logo}
                  alt={`${e.school} logo`}
                  loading="lazy"
                  decoding="async"
                  class:list={[
                    'max-h-full max-w-full object-contain',
                    'brightenOnDark' in e && e.brightenOnDark && 'dark:brightness-150',
                  ]}
                />
              </span>
              <div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                <span class="text-sm text-fg">
                  {e.school}
                  <span class="text-muted"> — {e.credential}</span>
                </span>
                <span class="text-xs text-subtle">{e.year}</span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

</BaseLayout>
