---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import EmailLink from '../components/EmailLink.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const nav = [
  { href: '#projects', label: 'Projects' },
  { href: '#work', label: 'Experience' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeScript />
    <BaseHead title={title} description={description} />
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-fg focus:shadow-lg"
    >
      Skip to content
    </a>

    <header
      class="sticky top-0 z-40 border-b border-border/60 bg-bg/80 backdrop-blur-md"
    >
      <div
        class="mx-auto flex max-w-(--container-site) items-center justify-between gap-4 px-6 py-4"
      >
        {/* Contact actions live here rather than in the hero, so they stay reachable
            once the page is scrolled. Labels shorten below `sm` to fit beside the nav. */}
        <div class="flex items-center gap-2">
          <EmailLink
            class="rounded-md px-3 py-1.5 text-sm font-medium text-brand transition-colors hover:bg-border/40"
          />
          <a
            href={SITE.resume}
            download="Bill-Kohler-Resume.pdf"
            class="rounded-md px-3 py-1.5 text-sm font-medium text-fg transition-colors hover:bg-border/40 hover:text-accent"
          >
            Resume<span class="hidden sm:inline"> (PDF)</span>
          </a>
          <a
            href={SITE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-md px-3 py-1.5 text-sm font-medium text-fg transition-colors hover:bg-border/40 hover:text-accent"
          >
            GitHub
          </a>
        </div>
        <div class="flex items-center gap-1">
          <nav aria-label="Sections" class="hidden sm:flex sm:items-center sm:gap-1">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:bg-border/40 hover:text-fg"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-border/60 py-10">
      <div class="mx-auto max-w-(--container-site) px-6 text-sm text-subtle">
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>

    {/* Lives here rather than in ProjectCard because that component renders once
        per project — colocating it there emitted four copies of the same handler.
        `autoplay` is an attribute no media query can suppress, and an autoplaying
        loop is exactly what reduced-motion asks not to see. Pausing leaves the
        poster frame up, so the icon cell still reads as the mark. */}
    <script is:inline>
      (() => {
        const query = matchMedia('(prefers-reduced-motion: reduce)');

        const apply = () => {
          for (const video of document.querySelectorAll('[data-motion-video]')) {
            if (query.matches) {
              video.pause();
              video.currentTime = 0;
            } else {
              video.play().catch(() => {
                /* A refused autoplay is fine — the poster stays put. */
              });
            }
          }
        };

        apply();
        query.addEventListener('change', apply);
      })();
    </script>
  </body>
</html>
